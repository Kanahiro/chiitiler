{
    "type": "module",
    "name": "chiitiler",
    "version": "2.0.1",
    "description": "Tiny map rendering server for MapLibre Style Spec",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=24.22.1"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "esbuild --bundle src/main.ts --minify --format=esm --outfile=build/main.mjs --platform=node --external:@ml2drender/node --external:@napi-rs/image --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
        "check": "tsc --noEmit",
        "dev": "CHIITILER_DEBUG=true tsx watch src/main.ts",
        "test:unit": "vitest src",
        "test:coverage": "vitest src --coverage --coverage.provider=v8",
        "test:integration": "vitest tests/integration.test.ts",
        "test:benchmark": "tsx tests/benchmark.ts",
        "docs": "typedoc src/index.ts --out docs --includeVersion",
        "lint": "biome check .",
        "format": "biome check --write ."
    },
    "keywords": [],
    "author": "Kanahiro Iguchi",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Kanahiro/chiitiler.git"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1168.0",
        "@biomejs/biome": "^2.6.7",
        "@google-cloud/storage": "^8.4.0",
        "@hono/node-server": "^2.1.8",
        "@maplibre/maplibre-gl-style-spec": "^26.7.0",
        "@napi-rs/image": "^1.16.0",
        "@tsconfig/node24": "^24.0.6",
        "@types/autocannon": "^7.12.7",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "autocannon": "^9.0.0",
        "esbuild": "^0.28.2",
        "hono": "^4.13.18",
        "image-size": "^2.1.0",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@ml2drender/node": "^0.4.3",
        "lru-cache": "^11.5.3",
        "pmtiles": "^4.5.0"
    },
    "peerDependencies": {
        "@aws-sdk/client-s3": "^3.0.0",
        "@google-cloud/storage": "^8.0.0 || ^9.0.0",
        "@maplibre/maplibre-gl-style-spec": "^26.4.4",
        "@napi-rs/image": "^1.16.0"
    },
    "peerDependenciesMeta": {
        "@aws-sdk/client-s3": {
            "optional": true
        },
        "@google-cloud/storage": {
            "optional": true
        },
        "@napi-rs/image": {
            "optional": true
        }
    },
    "packageManager": "pnpm@12.18.0"
}
